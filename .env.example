# Configuracion publica de Firebase (Web SDK).
#
# Copia este archivo a `.env.local` (que NUNCA se sube al repositorio) y pega
# los valores de tu proyecto de Firebase:
#
#   Firebase console > Project settings (⚙) > Your apps > Web app > SDK setup
#
# Estos valores son publicos por diseno: la seguridad la proporcionan las
# Security Rules de Firestore y la configuracion de "Authorized domains" del
# proveedor de identidad. Nunca pongas aqui claves privadas, credenciales de
# servicio (`firebase-admin`), ni secretos.
#
# La aplicacion arranca en "modo local" si faltan estas variables, para poder
# desarrollar y demostrar la interfaz antes de conectar Firebase.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Modo emulador (desarrollo local). Ponlo a `true` para trabajar contra los
# emuladores locales de Firebase:
#
#   npm run emulators      # en otra terminal
#   npm run dev
#
# Con esta opcion los datos se guardan solo en tu ordenador y el proyecto real
# de Firebase no se toca nunca.
VITE_USE_EMULATOR=false
